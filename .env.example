# Copie para .env.local e preencha. No Cloudflare, estas são as "Variáveis de build" do projeto.

# Supabase (Settings > API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Dados da loja (valores iniciais; depois dá para mudar no painel, aba Site)
VITE_STORE_NAME=Nome da Loja
VITE_WHATSAPP_NUMBER=5548999999999
VITE_CONTACT_EMAIL=contato@exemplo.com

# Só para o site de TESTE (faixa amarela de aviso no topo). Deixe vazio no site real.
# VITE_AMBIENTE_LABEL=Ambiente de teste

# Tipo de loja: "3d" (padrão, recursos de impressão 3D ligados) ou "generico" (loja comum)
VITE_NICHE=3d
